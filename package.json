{
  "name": "dsh-qq",
  "version": "0.5.3",
  "description": "QQ bot integration for DeepSeek Harness: bundled bot, SnowLuma/OneBot connection, control panel and QQ tools. SnowLuma itself is external.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "runtime.js",
    "setup.js",
    "login.js",
    "desktop.js",
    "deploy/*.yml",
    "cordis.patch.yml",
    "bot/src/*.mjs",
    "bot/test/*.test.mjs",
    "bot/package.json",
    "bot/config.example.json",
    "bot/snowluma-api-catalog.json",
    "locale/*.json",
    "scripts/*.mjs",
    "scripts/install-native.sh",
    "test/*.test.mjs",
    "icon.svg",
    "README.md",
    "docs/advanced.md",
    "docs/native.md",
    "LICENSE",
    "login-worker.js",
    "login-http.js",
    "original-login.js",
    "desktop-client.js",
    "assets/*",
    "assets/licenses/*"
  ],
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:release": "node --test test/*.test.mjs",
    "check:release": "node scripts/check-release.mjs",
    "pack:check": "npm run check:release",
    "prepack": "npm run check:release",
    "build:desktop": "node scripts/build-desktop.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale"
      ],
      "external": [
        "react"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@novnc/novnc": "1.5.0",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "qrcode": "1.5.4",
    "ws": "8.18.3"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "qq",
    "qqbot",
    "snowluma",
    "onebot",
    "chatbot"
  ],
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
